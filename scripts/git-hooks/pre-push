#!/usr/bin/env bash
# pre-push：推送前掃描這次要送出去的 commit，找到私有網段 IP 或私人關鍵字就擋下推送。
#
# 掃描範圍：每個新 commit 新增的行與檔名、作者與提交者、commit 訊息。
# 私人關鍵字（公司網域、專案路徑、同事帳號）本身就是不能公開的資訊，所以不寫在這裡，
# 由每台電腦自己的清單檔提供（預設 ~/.config/git/private-patterns，可用 PRIVATE_PATTERNS_FILE 換位置）：
# 一行一個延伸正規表示式（ERE），比對時不分大小寫，# 開頭與空行略過。
# 清單檔不存在時一律擋下，免得在新電腦上以為有掃描、其實沒有。
#
# 安裝（每個 clone 各做一次）：git config core.hooksPath scripts/git-hooks
# 確定是誤判、要硬推：git push --no-verify
#
# 寫法要相容 macOS 內建的 bash 3.2：不用關聯陣列與 mapfile，變數一律寫成 ${var}。

set -u

PATTERNS_FILE="${PRIVATE_PATTERNS_FILE:-${HOME}/.config/git/private-patterns}"
ZERO_SHA=0000000000000000000000000000000000000000
MAX_LINE_COLUMNS=160
# 固定用系統的 grep：PATH 上的 grep 可能是別的實作，\b 等語法不一定相同
GREP=/usr/bin/grep
[ -x "${GREP}" ] || GREP=grep

# 私有網段（RFC 1918）的 IPv4 位址，每台電腦都適用，所以內建；
# 前面不能接數字或點（避免把 v1.10.0.12 這類版本號當成 IP），後面不能接數字（句尾的句點照樣算）
PRIVATE_IP_PATTERN='(^|[^0-9.])(10\.[0-9]{1,3}|172\.(1[6-9]|2[0-9]|3[01])|192\.168)\.[0-9]{1,3}\.[0-9]{1,3}([^0-9]|$)'

if [ ! -f "${PATTERNS_FILE}" ]; then
  echo "pre-push：找不到私人關鍵字清單 ${PATTERNS_FILE}，先擋下推送。" >&2
  echo "  建立這個檔案（一行一個正規表示式），或確定沒有私人資訊時用 git push --no-verify。" >&2
  exit 1
fi

# 每一行去掉頭尾空白、包上括號再用 | 串起來，跟內建的 IP 規則合成一個 ERE
user_patterns=$("${GREP}" -v -E '^[[:space:]]*(#|$)' "${PATTERNS_FILE}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/.*/(&)/' | paste -sd '|' -)
COMBINED_PATTERN="${PRIVATE_IP_PATTERN}"
[ -n "${user_patterns}" ] && COMBINED_PATTERN="${COMBINED_PATTERN}|${user_patterns}"

# 清單裡有寫錯的正規表示式時 grep 會出錯而什麼都比對不到，等於放行，所以先檢查
printf '\n' | "${GREP}" -E -- "${COMBINED_PATTERN}" >/dev/null 2>&1
if [ $? -eq 2 ]; then
  echo "pre-push：${PATTERNS_FILE} 裡有無效的正規表示式，先擋下推送。" >&2
  exit 1
fi

findings=""

# 參數：commit 短碼，以及「位置<TAB>內容」的多行文字；把符合的行記進 findings
collect() {
  local short="$1" lines="$2" matched
  matched=$(printf '%s\n' "${lines}" | "${GREP}" -i -E -- "${COMBINED_PATTERN}" | cut -c1-"${MAX_LINE_COLUMNS}")
  [ -z "${matched}" ] && return
  findings="${findings}$(printf '%s\n' "${matched}" | sed "s/^/  ${short} /")
"
}

# 作者、提交者與訊息
commit_meta() {
  git log -1 --format='%an <%ae>%n%cn <%ce>%n%B' "$1" |
    awk 'NR == 1 { print "作者\t" $0; next } NR == 2 { print "提交者\t" $0; next } { print "訊息\t" $0 }'
}

# 這個 commit 新增或修改的行，格式「檔名:行號<TAB>內容」；刪掉的行不用管，內容早已在之前的 commit 裡
added_lines() {
  git -c core.quotePath=false show --format= --no-color --no-ext-diff --unified=0 "$1" |
    awk '
      # 檔名標頭只出現在 diff --git 之後、第一個 @@ 之前；內容剛好以 ++ 開頭的新增行不會被誤認
      /^diff --git / { in_header = 1; next }
      in_header && /^\+\+\+ / { file = substr($0, 7); next }
      /^@@ / { in_header = 0; split($3, range, ","); line = substr(range[1], 2) + 0; next }
      !in_header && /^\+/ { print file ":" line "\t" substr($0, 2); line++ }
    '
}

# 這個 commit 新增或改名後的檔名
changed_paths() {
  git -c core.quotePath=false diff-tree --root --no-commit-id --name-only -r "$1" | sed 's/^/檔名\t/'
}

scan_commit() {
  local commit="$1" short
  short=$(git rev-parse --short "${commit}")
  collect "${short}" "$(commit_meta "${commit}")"
  collect "${short}" "$(changed_paths "${commit}")"
  collect "${short}" "$(added_lines "${commit}")"
}

# stdin 每行是「本機 ref 本機 sha 遠端 ref 遠端 sha」
while read -r local_ref local_sha remote_ref remote_sha; do
  # 刪除遠端分支：沒有內容送出去
  [ "${local_sha}" = "${ZERO_SHA}" ] && continue
  if [ "${remote_sha}" != "${ZERO_SHA}" ] && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    commits=$(git rev-list "${remote_sha}..${local_sha}")
  else
    # 新分支，或強制推送時遠端的 commit 本機沒有：掃所有還不在任何遠端分支上的 commit
    commits=$(git rev-list "${local_sha}" --not --remotes)
  fi
  for commit in ${commits}; do
    scan_commit "${commit}"
  done
done

if [ -n "${findings}" ]; then
  {
    echo "pre-push：要推送的 commit 裡有疑似私人資訊（私有網段 IP 或 ${PATTERNS_FILE} 裡的關鍵字），已擋下推送："
    printf '%s' "${findings}"
    echo "處理方式：把內容換成範例資料，用 git commit --amend 或 git rebase -i 重寫這些 commit，再推一次。"
    echo "確定是誤判：git push --no-verify"
  } >&2
  exit 1
fi
exit 0
